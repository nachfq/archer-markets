# Only a disposable Robinhood TESTNET key. Never use a mainnet wallet.
# npm run wallet:testnet can create a local ignored .env without printing the key.
DEPLOYER_PRIVATE_KEY=
RH_RPC_URL=https://rpc.testnet.chain.robinhood.com
# Public default below is validated on chain before deployment.
RH_STOCK_ADDRESS=0xC9f9c86933092BbbfFF3CCb4b105A4A94bf3Bd4E
# Optional second testnet wallet for the two-person demo (never committed).
BUYER_PRIVATE_KEY=
# Optional local RPC override, never used for mainnet.
ANVIL_RPC_URL=http://127.0.0.1:8545
